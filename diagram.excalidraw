      "isDeleted": false,
      "boundElements": null,
      "updated": 1793617072424,
      "link": null,
      "locked": false,
      "text": "Flask Web Application\n\nStatic/Render Only\n- GET / --> index.html\n- GET /quotes --> quotes.html\n- GET /team --> team.html\n- GET /authors --> json\n\nDatabase Routes\n- GET /books --> BookRepository.all() --> render books.html\n- POST /books --> BookRepository.create() --> redirect /books\n- GET /films --> FilmRepository.all() --> render films.html\n- GET /users/new --> render_template sign.up.html\n- POST /users/new --> UserRepository.save() --> redirect /index.html\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "d9sxbpzpgsw2KbpfE6pzW",
      "originalText": "Flask Web Application\n\nStatic/Render Only\n- GET / --> index.html\n- GET /quotes --> quotes.html\n- GET /team --> team.html\n- GET /authors --> json\n\nDatabase Routes\n- GET /books --> BookRepository.all() --> render books.html\n- POST /books --> BookRepository.create() --> redirect /books\n- GET /films --> FilmRepository.all() --> render films.html\n- GET /users/new --> render_template sign.up.html\n- POST /users/new --> UserRepository.save() --> redirect /index.html\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
